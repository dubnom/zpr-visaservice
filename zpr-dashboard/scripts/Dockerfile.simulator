FROM golang:1.26-alpine3.22 AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -o /out/zpr-web-dashboard ./cmd/zpr-web-dashboard

FROM alpine:3.22

RUN apk add --no-cache ca-certificates docker-cli jq
COPY --from=build /out/zpr-web-dashboard /usr/local/bin/zpr-web-dashboard

EXPOSE 8788 8791
ENTRYPOINT ["/usr/local/bin/zpr-web-dashboard", "-mode", "simulator", "-listen", "0.0.0.0:8788"]