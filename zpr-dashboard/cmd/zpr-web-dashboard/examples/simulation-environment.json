{
  "name": "local-linux-zpr",
  "dns_server": "fd00:1:1::1",
  "trusted_services": [
    {
      "name": "default",
      "api": "file",
      "role": "base-attribute-authority"
    }
  ],
  "agents": [
    {
      "name": "visa-service",
      "artifact": "zpr-visaservice/vs",
      "boot_order": 10
    },
    {
      "name": "zpr-node",
      "artifact": "zpr-core/adapter/ph",
      "boot_order": 20
    },
    {
      "name": "control-room",
      "artifact": "zpr-visaservice/zpr-dashboard",
      "boot_order": 30
    }
  ],
  "services": [
    {
      "name": "PolicyService",
      "kind": "Policy",
      "endpoint": "HTTPS/8789",
      "command": "dashboard-stack"
    },
    {
      "name": "ControlService",
      "kind": "Control",
      "endpoint": "HTTPS/8790",
      "command": "dashboard-stack"
    },
    {
      "name": "SimulatorControlService",
      "kind": "MachineControl",
      "endpoint": "ZPR/TCP/8792",
      "command": "simulator-control",
      "provider": "simulator-control",
      "address": "fd5a:5052:adda:1:ffff:ffff:ffff:fffe"
    },
    {
      "name": "InternetGatewayWeb",
      "kind": "Gateway",
      "endpoint": "ZPR/TCP/8082",
      "command": "machine-07 workload",
      "provider": "internet-gateway",
      "address": "fd00:1:9::1",
      "external_network_connection": "public-internet"
    },
    {
      "name": "ControlRoom",
      "kind": "ControlRoom",
      "endpoint": "HTTP/8787",
      "command": "dashboard-stack"
    },
    {
      "name": "AuthService",
      "kind": "Auth",
      "endpoint": "HTTPS/8183",
      "command": "auth-sandbox"
    },
    {
      "name": "AttributeService",
      "kind": "Attribute",
      "endpoint": "HTTPS/8443",
      "command": "trusted-service"
    }
  ],
