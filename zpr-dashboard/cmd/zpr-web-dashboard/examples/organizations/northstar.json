  "services": [
    {"name": "PolicyService", "kind": "Policy", "endpoint": "HTTPS/8789", "description": "Policy evaluation and catalog."},
    {"name": "ControlService", "kind": "Control", "endpoint": "HTTPS/8790", "description": "Administration and telemetry APIs."},
    {"name": "AuthService", "kind": "Auth", "endpoint": "HTTPS/8183", "description": "Bootstrap authentication."},
    {"name": "AttributeService", "kind": "Attribute", "endpoint": "HTTPS/8443", "description": "LDAP-backed device attributes."},
    {"name": "UserAttributeService", "kind": "Attribute", "endpoint": "HTTPS/8444", "description": "LDAP-backed user profile and group-role attributes."},
    {"name": "EchoService", "kind": "Application", "endpoint": "ZPR/HTTP", "description": "Demo application endpoint."},
    {"name": "MetricsService", "kind": "Application", "endpoint": "ZPR/HTTP", "description": "Demo telemetry endpoint."}
  ]
