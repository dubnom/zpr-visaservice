{
  "id": "northstar",
  "name": "Northstar Labs",
  "description": "Research and engineering organization with campus and remote teams.",
  "runtime": {
    "driver": "linux-one-node",
    "topology": "single-node",
    "nodes": [{"id": "northstar-node", "location": "North Campus"}]
  },
  "directory": {
    "base_dn": "dc=northstar,dc=test",
    "seed_mode": "pregen",
    "ldif_files": ["demo-company.ldif", "demo-employees.ldif", "demo-roles.ldif", "demo-machines.ldif"],
    "health_uid": "adapter1",
    "identity_mappings": {"device.zpr.adapter.cn": "uid"},
    "attributes": ["ou", "title", "zprMachineId", "zprMachineType", "zprMachineModel", "zprMachineLocation", "zprMachineSecure", "zprMachineOwner"],
    "user_identity_mappings": {"user.sub": "uid"},
