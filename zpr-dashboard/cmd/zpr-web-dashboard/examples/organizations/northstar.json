    {"id":"LegalMatterFiles","name":"Legal Matter Files","actor_cn":"legal-matters","protocol":"ICMP6","icmp_type":128,"icmp_code":0},
    {"id":"SecureDeviceOperations","name":"Secure Device Operations","actor_cn":"secure-device-operations","protocol":"ICMP6","icmp_type":128,"icmp_code":0},
    {"id":"UserRecords","name":"User Records","actor_cn":"user-records","protocol":"ICMP6","icmp_type":128,"icmp_code":0}
