{
  "id": "demo",
  "name": "ZPR Demo",
  "description": "Unprovisioned UI-only profile with opt-in shared-topology provisioning for two explicitly enabled demo machines. Other machine records and the reference topology are not provisioned.",
  "packaged_provisioning": {
    "version": 2,
    "driver": "shared-approved-bootstrap",
    "primary_machine_id": "machine-01",
    "machines": ["machine-01", "machine-02"],
    "service": "OciWeb"
  },
  "runtime": {
    "driver": "docker-multinode",
    "topology": "multi-node",
    "nodes": [
      {
        "id": "demo-node-a",
        "location": "Demo Lab A",
        "substrate_address": "192.0.2.10",
        "zpr_address": "2001:db8::10"
      },
      {
        "id": "demo-node-b",
        "location": "Demo Lab B",
        "substrate_address": "192.0.2.11",
        "zpr_address": "2001:db8::11"
      }
    ]
  },
  "directory": {
    "base_dn": "dc=demo,dc=test",
    "seed_mode": "ldif",
    "ldif_files": ["demo.ldif"],
    "health_uid": "demo-adapter",
    "identity_mappings": {
      "device.zpr.adapter.cn": "uid"
    },
    "attributes": ["uid"],
    "departments": [],
    "people": [],
    "groups": []
  },
  "policies": [],
  "services": []
}
