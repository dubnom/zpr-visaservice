{
  "schema_version": 2,
  "organization": {
    "id": "example-company",
    "name": "Example Company"
  },
  "control_room": {
    "origin": "https://control.example.com",
    "management_ip": "10.20.30.40",
    "certificate_file": "/etc/zpr/tls/control-room-chain.pem",
    "key_file": "/etc/zpr/secrets/control-room-key.pem"
  },
  "control_service": {
    "url": "https://control-service.example.com:8790",
    "client_certificate_file": "/etc/zpr/tls/control-service-client-chain.pem",
    "client_key_file": "/etc/zpr/secrets/control-service-client-key.pem",
    "ca_file": "/etc/zpr/tls/control-service-ca.pem",
    "tls_server_name": "control-service.example.com"
  },
  "budget_authority": {
    "database_file": "/var/lib/zpr/control-service/budget-authority.db",
    "delegation_trust_file": "/etc/zpr/config/operator-delegation-trust.json",
    "service_listen_address": "10.20.30.41:8790",
    "service_certificate_file": "/etc/zpr/tls/control-service-server-chain.pem",
    "service_key_file": "/etc/zpr/secrets/control-service-server-key.pem",
    "service_client_ca_file": "/etc/zpr/tls/control-service-client-ca.pem",
    "control_room_signer_file": "/etc/zpr/config/control-room-delegation-signer.json",
    "control_room_signer_key_file": "/etc/zpr/secrets/control-room-delegation-key.pem",
    "control_room_signer_audience": "https://control-service.example.com:8790"
  },
  "oidc": {
    "config": {
      "version": 1,
      "issuer": "https://login.example.com",
      "client_id": "zpr-control-room",
      "redirect_url": "https://control.example.com/auth/operator/callback",
      "session_lifetime_seconds": 900,
      "grants": [
        {
          "issuer": "https://login.example.com",
          "subject": "replace-with-exact-oidc-subject",
          "organizations": ["example-company"],
          "permissions": ["monitor.read", "budget.approve"]
        }
      ]
    },
    "client_secret_file": "/etc/zpr/secrets/oidc-client-secret"
  }
}
