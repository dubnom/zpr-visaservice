FROM golang:1.26-alpine3.22 AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 go build -trimpath -o /out/zpr-web-dashboard ./cmd/zpr-web-dashboard

FROM alpine:3.22

RUN apk add --no-cache ca-certificates \
    && addgroup -S -g 65532 zpr \
    && adduser -S -D -H -u 65532 -G zpr zpr
COPY --from=build /out/zpr-web-dashboard /usr/local/bin/zpr-web-dashboard
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/zpr-web-dashboard"]
