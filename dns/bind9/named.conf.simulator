acl zpr_clients {
    fd00:1::/32;
    fd5a:5052::/32;
};

include "/run/named/zpr-vs-publisher.key";
include "/run/named/zpr-dns-viewer.key";

options {
    directory "/var/cache/bind";
    recursion no;
    dnssec-validation no;
    allow-recursion { none; };
    allow-query-cache { none; };
    allow-query { zpr_clients; };
    allow-transfer { none; };
    listen-on port 53 { none; };
    listen-on-v6 port 53 { fd00:1:1::1; };
    zone-statistics full;
};

statistics-channels {
    inet 127.0.0.1 port 8053 allow { localhost; };
};

zone "svc.zpr" {
    type primary;
    file "/var/lib/bind/db.svc.zpr";
    allow-transfer { key "zpr-dns-viewer"; };
    update-policy {
        grant zpr-vs-publisher zonesub A AAAA;
    };
};

zone "1.0.0.0.0.0.d.f.ip6.arpa" {
    type primary;
    file "/var/lib/bind/db.fd00-1.ip6";
    allow-transfer { key "zpr-dns-viewer"; };
    update-policy { grant zpr-vs-publisher zonesub PTR; };
};

zone "2.5.0.5.a.5.d.f.ip6.arpa" {
    type primary;
    file "/var/lib/bind/db.fd5a-5052.ip6";
    allow-transfer { key "zpr-dns-viewer"; };
    update-policy { grant zpr-vs-publisher zonesub PTR; };
};

zone "10.in-addr.arpa" {
    type primary;
    file "/var/lib/bind/db.10.in-addr";
    allow-transfer { key "zpr-dns-viewer"; };
    update-policy { grant zpr-vs-publisher zonesub PTR; };
};