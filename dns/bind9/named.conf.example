// BIND 9 authoritative-only private ZPR DNS service.
// Replace the example addresses and key material for the deployment.
acl zpr_clients {
    fd5a:5052:adda:1::/64;
};

include "/etc/bind/keys/zpr-vs-publisher.key";

options {
    directory "/var/cache/bind";
    recursion no;
    allow-recursion { none; };
    allow-query-cache { none; };
    allow-query { zpr_clients; };
    listen-on port 53 { none; };
    listen-on-v6 port 53 { fd5a:5052:adda:1::53; };
};

zone "svc.zpr" {
    type primary;
    file "/var/lib/bind/db.svc.zpr";
    update-policy {
        grant zpr-vs-publisher zonesub A AAAA;
    };
};
